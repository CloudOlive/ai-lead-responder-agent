# Copy to .env and fill in. Never commit .env.

# true = use FakeSender (no texts sent, no Twilio account needed) and skip signature checks
DEMO_MODE=false

# Twilio console > Account info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# The Twilio number customers call, E.164 format
TWILIO_PHONE_NUMBER=+15555550123

# Public https URL that reaches this server (your ngrok URL), no trailing slash.
# Used to validate Twilio request signatures.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# Optional: overrides owner_phone in business.yaml so your real number stays out of git
OWNER_PHONE=

# Optional: path to the business config file
BUSINESS_CONFIG_PATH=business.yaml

# Used from Milestone 2 onward
ANTHROPIC_API_KEY=sk-ant-your-key-here
